---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import TOC from "@components/widget/TOC.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle headings={headings}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<article id="post-container" class="sport-reading">
		<header class="sport-heading-rule">
			<a href={url("/blog/")} class="sport-kicker sport-back">TECH JOURNAL / 返回博客</a>
			<h1 class="sport-heading" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
			{entry.data.description && <p class="sport-article-description">{entry.data.description}</p>}
			<PostMetadata
				published={entry.data.published}
				updated={entry.data.updated}
				tags={entry.data.tags}
				category={entry.data.category}
			/>
			<p class="sport-meta sport-stats">
				<span>{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}</span>
				<span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
			</p>
		</header>

		{siteConfig.toc.enable && headings.length > 0 && <details class="sport-mobile-toc">
			<summary class="sport-kicker">ON THIS PAGE / 目录</summary>
			<TOC headings={headings} />
		</details>}

		{entry.data.image && entry.data.showCover &&
			<ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} alt={entry.data.title} class="sport-article-cover" />
		}

		<Markdown class="sport-prose markdown-content">
			<Content />
		</Markdown>

		{licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="sport-license" />}

		{(entry.data.nextSlug || entry.data.prevSlug) && <nav aria-label="相邻文章" class="sport-adjacent">
			{entry.data.nextSlug && <a href={getPostUrlBySlug(entry.data.nextSlug)}>
				<Icon name="material-symbols:chevron-left-rounded" />
				{entry.data.nextTitle}
			</a>}
			{entry.data.prevSlug && <a href={getPostUrlBySlug(entry.data.prevSlug)}>
				{entry.data.prevTitle}
				<Icon name="material-symbols:chevron-right-rounded" />
			</a>}
		</nav>}
	</article>
</MainGridLayout>

<style>
	.sport-back:hover {
		text-decoration: underline;
		text-underline-offset: .25em;
	}
	.sport-article-description {
		margin: .8rem 0 1.1rem;
		max-width: 44rem;
		color: var(--sport-copy);
		font-size: 1.0625rem;
		line-height: 1.65;
	}
	.sport-stats {
		display: flex;
		flex-wrap: wrap;
		gap: .35rem 1rem;
		margin-top: .55rem;
	}
	.sport-mobile-toc {
		margin-top: 1rem;
		padding: .65rem .85rem;
		border: 1px solid var(--sport-line);
	}
	.sport-mobile-toc summary {
		min-height: 1.75rem;
		cursor: pointer;
	}
	.sport-mobile-toc[open] summary {
		margin-bottom: .5rem;
	}
	:global(.sport-article-cover) {
		margin-top: 1.5rem;
		border-inline-start: 3px solid var(--sport-accent);
	}
	:global(.sport-article-cover img) {
		width: 100%;
		height: auto;
	}
	#post-container :global(.sport-prose) {
		margin-top: 1.75rem;
	}
	#post-container :global(.sport-license) {
		margin-block: 2.25rem 1.5rem;
		border: 1px solid var(--sport-line);
		border-radius: 0;
	}
	.sport-adjacent {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: .75rem;
	}
	.sport-adjacent a {
		display: inline-flex;
		align-items: center;
		gap: .35rem;
		padding: .5rem 0;
		color: var(--sport-accent);
	}
	@media (min-width: 64rem) {
		.sport-mobile-toc { display: none; }
	}
</style>
