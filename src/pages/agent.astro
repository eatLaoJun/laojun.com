---
import RoomStudio from "../room/RoomStudio.svelte";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#f5f7fb" />
		<meta name="description" content="在 2D 和 3D 中布置一个含卫生间的个人房间。" />
		<link rel="icon" href={url("/favicon/favicon-dark-32.png")} />
		<title>房间工作台 | {siteConfig.title}</title>
	</head>
	<body>
		<RoomStudio client:load home={url("/")} />
		<noscript>房间工作台需要 JavaScript。<a href={url("/")}>返回首页</a></noscript>
	</body>
</html>

<style>
	html { color-scheme: light; background: #f5f7fb; }
	body { margin: 0; }
</style>
