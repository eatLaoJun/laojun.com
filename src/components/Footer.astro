---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<footer class="sport-footer sport-meta">
	<span>{profileConfig.name.toUpperCase()} / JOURNAL</span>
	<nav aria-label="站点订阅与版权">
		<a href={url("/rss.xml")} data-no-swup>RSS</a>
		<a href={url("/sitemap-index.xml")} data-no-swup>Sitemap</a>
		<span>&copy; {currentYear}</span>
	</nav>
</footer>

<style>
	.sport-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: .6rem 1.25rem;
		border-top: 1px solid var(--sport-line);
		margin-top: 1.2rem;
		padding-block: 1.05rem 2.5rem;
		font-size: 0.75rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	a:hover {
		color: var(--sport-accent);
	}
</style>
