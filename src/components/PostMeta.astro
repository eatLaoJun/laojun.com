---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
}

const { published, updated, tags, category } = Astro.props;
const date = formatDateToYYYYMMDD(published);
const updatedDate = updated && formatDateToYYYYMMDD(updated);
---

<div class="sport-meta post-meta">
	<time datetime={date}>{date}</time>
	{updatedDate && updatedDate !== date && <span>更新于 <time datetime={updatedDate}>{updatedDate}</time></span>}
	<a class="category" href={getCategoryUrl(category)}>{category || i18n(I18nKey.uncategorized)}</a>
	{tags.map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}
</div>

<style>
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: .45rem .85rem;
		margin-top: 1rem;
		overflow-wrap: anywhere;
	}
	.category {
		color: var(--sport-accent);
	}
	a:hover {
		color: var(--sport-accent);
		text-decoration: underline;
		text-underline-offset: .24em;
	}
</style>
