---
import { Icon } from "astro-icon/components";
import { navBarConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { pathsEqual, url } from "../utils/url-utils";
import Search from "./Search.svelte";

interface Props {
	currentSection: string;
}

const { currentSection } = Astro.props;
const links = navBarConfig.links.map((item) =>
	typeof item === "number" ? LinkPresets[item] : item,
);
---

<header id="navbar" class="sport-navbar">
	<a href={url("/")} data-no-swup class="sport-mark" aria-label="LaoJun 首页">LJ.</a>
	<nav aria-label="站点导航" class="sport-nav">
		{links.map(({ name, url: link, external }) => {
			const href = external ? link : url(link);
			return <a href={href}
				data-sport-nav={external ? undefined : href}
				aria-current={!external && pathsEqual(href, currentSection) ? "page" : undefined}
				target={external ? "_blank" : undefined}
				rel={external ? "noopener noreferrer" : undefined}
			>{name}</a>;
		})}
	</nav>
	<div class="sport-tools">
		<div class="sport-search"><Search client:only="svelte" /></div>
		<button id="sport-theme-switch" type="button" aria-label="切换到浅色模式" title="切换到浅色模式" hidden>
			<span class="theme-to-light" aria-hidden="true">
				<Icon name="material-symbols:wb-sunny-outline-rounded" />
				<span class="theme-label">浅色</span>
			</span>
			<span class="theme-to-dark" aria-hidden="true">
				<Icon name="material-symbols:dark-mode-outline-rounded" />
				<span class="theme-label">深色</span>
			</span>
		</button>
	</div>
</header>

<style>
	.sport-navbar {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		min-height: 4.1rem;
		gap: clamp(.4rem, 1.8vw, 1.6rem);
		border-bottom: 1px solid var(--sport-line);
	}
	.sport-mark {
		flex: 0 0 auto;
		margin-inline-end: auto;
		width: fit-content;
		color: var(--sport-accent);
		font: italic 900 2rem / 1 var(--sport-display);
		letter-spacing: -.06em;
	}
	.sport-nav {
		display: flex;
		align-items: center;
		gap: clamp(.25rem, 2vw, 1.4rem);
	}
	.sport-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: clamp(.25rem, 1vw, .65rem);
		color: var(--sport-muted);
		font-size: .875rem;
		white-space: nowrap;
	}
	.sport-nav a:hover {
		color: var(--sport-accent);
	}
	.sport-nav a[aria-current="page"] {
		color: var(--sport-ink);
		box-shadow: inset 2px 0 0 var(--sport-accent);
	}
	.sport-search :global(#search-bar) {
		border-radius: 2px;
		margin-right: 0;
	}
	.sport-search :global(#search-switch) {
		border-radius: 2px;
	}
	.sport-tools {
		display: flex;
		align-items: center;
		gap: clamp(0rem, 1vw, .6rem);
	}
	#sport-theme-switch {
		display: grid;
		place-items: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		border: 1px solid var(--sport-line);
		color: var(--sport-accent);
	}
	#sport-theme-switch[hidden] {
		display: none;
	}
	#sport-theme-switch:hover {
		background: var(--btn-plain-bg-hover);
	}
	#sport-theme-switch > span {
		align-items: center;
		gap: .35rem;
		font-size: 1.15rem;
	}
	.theme-to-light,
	:global(.dark) .theme-to-dark {
		display: none;
	}
	.theme-to-dark,
	:global(.dark) .theme-to-light {
		display: inline-flex;
	}
	.theme-label {
		display: none;
	}
	@media (min-width: 42rem) {
		#sport-theme-switch {
			padding-inline: .6rem;
		}
		.theme-label {
			display: inline;
			font-size: .8125rem;
		}
	}
	@media (max-width: 24rem) {
		.sport-navbar {
			gap: .25rem;
		}
		.sport-tools {
			gap: 0;
		}
		.sport-nav {
			gap: .125rem;
		}
		.sport-nav a {
			padding-inline: .15rem;
			font-size: .8125rem;
		}
	}
</style>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
