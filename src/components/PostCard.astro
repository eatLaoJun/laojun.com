---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	entry: CollectionEntry<"posts">;
	href: string;
	number: number;
}

const { entry, href, number } = Astro.props;
const { title, description, image, published, tags, category } = entry.data;
const date = formatDateToYYYYMMDD(published);
const { remarkPluginFrontmatter } = await entry.render();
---

<article class:list={["sport-post", { "no-cover": !image }]}>
	{image && <a href={href} class="sport-post-cover" tabindex="-1" aria-hidden="true">
		<ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} />
	</a>}
	<div class="sport-post-copy">
		<div class="sport-meta sport-post-label">
			<span class="sport-post-number">{String(number).padStart(2, "0")} /</span>
			{category && <a href={getCategoryUrl(category)}>{category}</a>}
			<time datetime={date}>{date.replaceAll("-", ".")}</time>
		</div>
		<h2><a href={href}>{title}</a></h2>
		<p>{description || remarkPluginFrontmatter.excerpt}</p>
		{tags.length > 0 && <ul class="sport-meta">
			{tags.map((tag) => <li><a href={getTagUrl(tag)}>#{tag}</a></li>)}
		</ul>}
	</div>
	<a href={href} tabindex="-1" aria-hidden="true" class="sport-post-arrow">&nearr;</a>
</article>

<style>
	.sport-post {
		display: grid;
		grid-template-columns: clamp(5rem, 19vw, 12rem) minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(.75rem, 3.2vw, 2rem);
		padding-block: clamp(1.1rem, 3vw, 1.8rem);
	}
	.sport-post + .sport-post {
		border-top: 1px solid var(--sport-line);
	}
	.no-cover {
		grid-template-columns: minmax(0, 1fr) auto;
	}
	.sport-post-cover {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 3.7rem;
		overflow: hidden;
		border-inline-start: 3px solid var(--sport-accent);
		background: var(--card-bg);
	}
	.sport-post-cover > :global(div) {
		position: absolute;
		inset: 0;
	}
	.sport-post-cover :global(img) {
		filter: saturate(.8);
		transition: transform 240ms ease;
	}
	.sport-post-cover:hover :global(img) {
		transform: scale(1.04);
	}
	.sport-post-label, ul {
		display: flex;
		flex-wrap: wrap;
		gap: .2rem .75rem;
		overflow-wrap: anywhere;
	}
	.sport-post-label a, .sport-post-number {
		color: var(--sport-accent);
	}
	h2 {
		margin: .25rem 0;
		font-size: clamp(1.15rem, 3vw, 1.85rem);
		font-weight: 800;
		line-height: 1.32;
		text-wrap: pretty;
		overflow-wrap: anywhere;
	}
	h2 a:hover, ul a:hover, .sport-post-label a:hover {
		color: var(--sport-accent);
		text-decoration: underline;
		text-underline-offset: .22em;
	}
	.sport-post-copy p {
		color: var(--sport-copy);
		line-height: 1.55;
	}
	ul {
		margin-top: .5rem;
	}
	.sport-post-arrow {
		width: 2.2rem;
		text-align: center;
		color: var(--sport-accent);
		font: 400 1.6rem / 1.2 var(--sport-mono);
	}
	@media (max-width: 35rem) {
		.sport-post { grid-template-columns: clamp(4rem, 18vw, 6rem) minmax(0, 1fr); }
		.no-cover { grid-template-columns: minmax(0, 1fr); }
		.sport-post-cover { align-self: start; margin-top: .15rem; }
		.sport-post-arrow { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.sport-post-cover :global(img) { transition: none; }
	}
</style>
