---
import type { MarkdownHeading } from "astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import TOC from "@components/widget/TOC.astro";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const { title, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
const navSection = Astro.url.pathname.startsWith(url("/posts/")) ||
	Astro.url.pathname.startsWith(url("/blog/")) ? url("/blog/") : Astro.url.pathname;
const showToc = siteConfig.toc.enable && headings.length > 0;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
	<slot slot="head" name="head" />
	<div class="sport-shell">
		<Navbar currentSection={navSection} />
		<div class="sport-frame">
			<main id="swup-container" class="transition-swup-fade" data-sport-section={navSection}>
				<slot />
			</main>
			<div id="toc" class="transition-swup-fade sport-toc">
				{showToc && <aside aria-label="文章目录">
					<p class="sport-kicker">ON THIS PAGE / 目录</p>
					<TOC headings={headings} />
				</aside>}
			</div>
		</div>
		<Footer />
	</div>
</Layout>

<style>
	.sport-frame {
		min-width: 0;
	}
	main {
		min-width: 0;
	}
	.sport-toc {
		display: none;
	}
	@media (min-width: 64rem) {
		.sport-frame:has(.sport-toc aside) {
			display: grid;
			grid-template-columns: minmax(0, 48rem) minmax(0, 1fr);
			gap: clamp(1.6rem, 4vw, 3.75rem);
			align-items: start;
		}
		.sport-toc:has(aside) {
			display: block;
			position: sticky;
			top: 2rem;
			margin-top: 3.5rem;
		}
		.sport-toc aside {
			max-height: calc(100dvh - 4rem);
			overflow-y: auto;
			padding-inline-start: .85rem;
			border-inline-start: 1px solid var(--sport-line);
		}
		.sport-toc p {
			margin-bottom: .65rem;
		}
		.sport-toc :global(table-of-contents a) {
			border-radius: 0;
		}
	}
</style>
