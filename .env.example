# Room Studio 后端服务配置
PORT=8787
DB_PATH=./data/room-studio.db

# PiAgent LLM 配置（通过 @mariozechner/pi-ai 原生支持多家模型）
# 可选 provider 示例：openai | anthropic | google | deepseek | openrouter | xai | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 如果使用自定义 OpenAI 兼容接口 / 中转站 / 本地 Ollama，可设置以下地址（留空则使用 provider 默认地址）
LLM_BASE_URL=
